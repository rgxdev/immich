#!/usr/bin/env bash

if [[ "$IMMICH_ENV" == "production" ]]; then
  echo "This command can only be run in development environments"
  exit 1
fi

cd /usr/src/app/server || exit
export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=4096"
exec ./node_modules/.bin/nest start --debug "0.0.0.0:9230" --watch -- "$@"
